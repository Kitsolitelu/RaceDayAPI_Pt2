@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Something went wrong";
}
<div class="container py-5 text-center">
    @if (Model == 404)
    {
        <h1 class="display-5">We could not find that page</h1>
        <p class="lead text-muted">The page or event you are looking for does not exist, or it was removed.</p>
    }
    else
    {
        <h1 class="display-5">Something went wrong</h1>
        <p class="lead text-muted">We could not open that page. Please try again.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
