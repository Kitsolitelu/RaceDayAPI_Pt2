@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}
<div class="container auth-wrap">
    <div class="card auth-card">
        <div class="card-body p-4">
            <h1 class="h2">Join RaceDay</h1>
            <p class="text-muted">Create your account to enrol in events or run your own.</p>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label class="form-label d-block">I want to</label>
                    <div class="btn-group w-100" role="group" aria-label="Choose your role">
                        <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="rolePart" />
                        <label class="btn btn-outline-primary" for="rolePart">Take part in events</label>
                        <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleOrg" />
                        <label class="btn btn-outline-primary" for="roleOrg">Organise events</label>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div id="organiserCodeBox" class="mb-3 @(Model.Role == "Organiser" ? "" : "d-none")">
                    <label asp-for="OrganiserCode" class="form-label"></label>
                    <input asp-for="OrganiserCode" class="form-control" autocomplete="off" />
                    <div class="form-text">Organisers need the access code given to them.</div>
                    <span asp-validation-for="OrganiserCode" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least 8 characters.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Create account</button>
            </form>

            <p class="mt-3 mb-0 text-center">Already have an account? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // only organisers need to see the access code box
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.getElementById('organiserCodeBox')
                    .classList.toggle('d-none', document.getElementById('roleOrg').checked === false);
            });
        });
    </script>
}
