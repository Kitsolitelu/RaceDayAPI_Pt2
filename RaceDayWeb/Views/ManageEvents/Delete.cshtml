@model EventResponseDto
@{
    ViewData["Title"] = "Delete event";
}
<div class="container py-4" style="max-width:640px">
    <h1>Delete this event?</h1>
    <div class="card border-danger">
        <div class="card-body">
            <h2 class="h4">@Model.Name</h2>
            <p class="mb-1">@Model.EventDate.ToString("dd MMM yyyy") - @Model.Location</p>
            <p class="text-danger fw-semibold mt-3">
                This also removes its categories, enrolments and results. This cannot be undone.
            </p>
            <form asp-action="Delete" asp-route-id="@Model.EventId" method="post" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, delete the event</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Keep it</a>
            </form>
        </div>
    </div>
</div>
