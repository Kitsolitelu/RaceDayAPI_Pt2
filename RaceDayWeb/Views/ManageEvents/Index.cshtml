@model List<EventResponseDto>
@{
    ViewData["Title"] = "My events";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="mb-0">My events</h1>
        <a class="btn btn-primary" asp-action="Create">Create event</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No events yet</h2>
            <p>Create an event, add categories, then share it with participants.</p>
            <a class="btn btn-primary" asp-action="Create">Create your first event</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th></th><th>Event</th><th>Date</th><th>Type</th><th>Distance</th><th class="text-end">Manage</th></tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td style="width:72px">
                                @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                {
                                    <img src="@ev.BannerUrl" class="thumb" alt="Banner for @ev.Name" />
                                }
                                else
                                {
                                    <div class="thumb thumb-empty">@ev.EventType.Substring(0, 1)</div>
                                }
                            </td>
                            <td><strong>@ev.Name</strong><div class="small text-muted">@ev.Location</div></td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.EventType</td>
                            <td>@(ev.Distance?.ToString("0.##") ?? "-") km</td>
                            <td class="text-end manage-actions">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@ev.EventId">Categories</a>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">Enrolments</a>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a>
                                <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@ev.EventId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
