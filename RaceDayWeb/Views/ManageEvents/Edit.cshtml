@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}
<div class="container py-4">
    <h1>Edit event</h1>
    <div class="card"><div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventFields" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div></div>
</div>
