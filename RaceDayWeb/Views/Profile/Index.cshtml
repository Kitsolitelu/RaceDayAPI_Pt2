@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
<div class="container py-4">
    <h1>My profile</h1>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" class="profile-photo" alt="Your profile picture" />
                    }
                    else
                    {
                        <div class="profile-photo profile-photo-empty">@(char.ToUpper(Model.FullName.Trim().FirstOrDefault()))</div>
                    }
                    <h2 class="h5 mt-3 mb-1">@Model.FullName</h2>
                    <span class="role-chip role-chip-dark">@Model.Role</span>

                    <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-4 text-start">
                        <label class="form-label" for="picture">Profile picture</label>
                        <input id="picture" name="picture" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" required />
                        <div class="form-text">JPG, PNG or WEBP, 5 MB at most.</div>
                        <button type="submit" class="btn btn-outline-primary w-100 mt-3">Upload picture</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-body p-4">
                    <h2 class="h4">Your details</h2>
                    <form asp-action="Index" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
