@model List<ResultResponseDto>
@{
    ViewData["Title"] = "My results";
}
<div class="container py-4">
    <h1>My results</h1>
    <p class="text-muted">Your race history across all the events you have finished.</p>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No results yet</h2>
            <p>Results appear here once an organiser captures them after your event.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EventName</td>
                            <td>@(r.EventDate.HasValue ? r.EventDate.Value.ToString("dd MMM yyyy") : "-")</td>
                            <td>@r.CategoryName</td>
                            <td class="time-cell">@Formatters.Time(r.FinishTime)</td>
                            <td>
                                @if (r.Position.HasValue && r.TotalFinishers.HasValue)
                                {
                                    <strong>@Formatters.Ordinal(r.Position.Value)</strong> <span class="text-muted">out of @r.TotalFinishers finishers</span>
                                }
                                else if (r.Position.HasValue)
                                {
                                    <strong>@Formatters.Ordinal(r.Position.Value)</strong>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
